{
  "bold": [
    "x → x",
    "  → x ",
    "* → x *",
    "* → x **",
    "b → x **b",
    "o → x **bo",
    "l → x **bol",
    "d → x **bold",
    "* → x **bold*",
    "* → x <b>bold</b>",
    "  → x <b>bold</b> ",
    "y → x <b>bold</b> y"
  ],
  "italic": [
    "x → x",
    "  → x ",
    "* → x *",
    "i → x *i",
    "t → x *it",
    "a → x *ita",
    "l → x *ital",
    "i → x *itali",
    "c → x *italic",
    "* → x <i>italic</i>",
    "  → x <i>italic</i> ",
    "y → x <i>italic</i> y"
  ],
  "strike": [
    "x → x",
    "  → x ",
    "~ → x ~",
    "~ → x ~~",
    "s → x ~~s",
    "t → x ~~st",
    "r → x ~~str",
    "i → x ~~stri",
    "k → x ~~strik",
    "e → x ~~strike",
    "~ → x ~~strike~",
    "~ → x <s>strike</s>",
    "  → x <s>strike</s> ",
    "y → x <s>strike</s> y"
  ],
  "highlight": [
    "x → x",
    "  → x ",
    "= → x =",
    "= → x ==",
    "h → x ==h",
    "l → x ==hl",
    "= → x ==hl=",
    "= → x <hl>hl</hl>",
    "  → x <hl>hl</hl> ",
    "y → x <hl>hl</hl> y"
  ],
  "code": [
    "x → x",
    "  → x ",
    "` → x `",
    "c → x `c",
    "o → x `co",
    "d → x `cod",
    "e → x `code",
    "` → x <code>code</code>",
    "  → x <code>code</code> ",
    "y → x <code>code</code> y"
  ],
  "math": [
    "x → x",
    "  → x ",
    "$ → x $",
    "m → x $m",
    "$ → x <math:m>",
    "  → x <math:m> ",
    "y → x <math:m> y"
  ],
  "boldItalic": [
    "x → x",
    "  → x ",
    "* → x *",
    "* → x **",
    "* → x ***",
    "b → x ***b",
    "i → x ***bi",
    "* → x ***bi*",
    "* → x ***bi**",
    "* → x <b><i>bi</i></b>",
    "  → x <b><i>bi</i></b> ",
    "y → x <b><i>bi</i></b> y"
  ],
  "subSup": [
    "H → H",
    "~ → H~",
    "2 → H~2",
    "~ → H<sub>2</sub>",
    "O → H<sub>2</sub>O",
    "  → H<sub>2</sub>O ",
    "x → H<sub>2</sub>O x",
    "^ → H<sub>2</sub>O x^",
    "2 → H<sub>2</sub>O x^2",
    "^ → H<sub>2</sub>O x<sup>2</sup>",
    "  → H<sub>2</sub>O x<sup>2</sup> ",
    "y → H<sub>2</sub>O x<sup>2</sup> y"
  ],
  "singleTilde": [
    "x → x",
    "  → x ",
    "~ → x ~",
    "a → x ~a",
    "  → x ~a ",
    "b → x ~a b",
    "~ → x ~a b~",
    "  → x ~a b~ ",
    "y → x ~a b~ y"
  ],
  "link": [
    "x → x",
    "  → x ",
    "[ → x []",
    "t → x [t]",
    "] → x [t]",
    "( → x [t]()",
    "h → x [t](h)",
    "t → x [t](ht)",
    "t → x [t](htt)",
    "p → x [t](http)",
    "s → x [t](https)",
    ": → x [t](https:)",
    "/ → x [t](https:/)",
    "/ → x [t](https://)",
    "a → x [t](https://a)",
    ". → x [t](https://a.)",
    "b → x [t](https://a.b)",
    ") → x <a>t</a>",
    "  → x <a>t</a> ",
    "y → x <a>t</a> y"
  ],
  "undoBold": [
    "x → x",
    "  → x ",
    "* → x *",
    "* → x **",
    "b → x **b",
    "* → x **b*",
    "* → x <b>b</b>",
    "{Control+z} → x **b**",
    "  → x **b** ",
    "* → x **b** *",
    "i → x **b** *i",
    "* → x **b** <i>i</i>",
    "  → x **b** <i>i</i> ",
    "y → x **b** <i>i</i> y"
  ],
  "undoMath": [
    "x → x",
    "  → x ",
    "$ → x $",
    "a → x $a",
    "$ → x <math:a>",
    "{Control+z} → x $a$",
    "  → x $a$ ",
    "a → x $a$ a",
    "n → x $a$ an",
    "d → x $a$ and",
    "  → x $a$ and ",
    "$ → x $a$ and $",
    "b → x $a$ and $b",
    "$ → x $a$ and <math:b>",
    "  → x $a$ and <math:b> ",
    "y → x $a$ and <math:b> y"
  ],
  "undoHighlight": [
    "x → x",
    "  → x ",
    "= → x =",
    "= → x ==",
    "a → x ==a",
    "= → x ==a=",
    "= → x <hl>a</hl>",
    "{Control+z} → x ==a==",
    "  → x ==a== ",
    "= → x ==a== =",
    "= → x ==a== ==",
    "b → x ==a== ==b",
    "= → x ==a== ==b=",
    "= → x ==a== <hl>b</hl>",
    "  → x ==a== <hl>b</hl> ",
    "y → x ==a== <hl>b</hl> y"
  ]
}
