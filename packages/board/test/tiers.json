{
  "_doc": "Test tiers, see TESTING.md. smoke: always run by npm run check and PR CI (one quick scenario per main feature). areas: feature areas, each with the files that belong to it (globs, source and scenario specs) and a hand-picked group of scenarios that runs whole when a change touches one of them; broad: the same for changes no area holds. limits: seconds of scenario time for a group beside smoke (area), for smoke, and for smoke with the three largest groups (local). manual: left out of every default run, run them by name. known: checks failing on main that are tracked elsewhere; their FAIL lines are reported but don't fail a run (remove the entry with the fix).",
  "smoke": [
    "expandCall", "peek", "notes", "markdownRender", "markdownEdit", "export", "patchsave", "versions", "compare", "web", "calltree",
    "emptyquestion", "runtime", "syncundo", "sharedsync", "walkthroughOrder", "zoomLevels", "palette", "settingsPage", "linkMergeSection",
    "stickerBitmapsPicker", "notePastedImageSameSizeInBothModes"
  ],
  "manual": ["markdownRecord"],
  "solo": ["markdownLazyRender", "codeEditKeystrokeLatency", "variantTabSwitchTime", "changesReachHostTime", "mathHintsKeystrokeTime"],
  "known": {},
  "limits": {"area": 30, "smoke": 90, "local": 180},
