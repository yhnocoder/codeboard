{
  "name": "@yhnocoder/markdown",
  "version": "0.1.1",
  "description": "A Typora-style WYSIWYG Markdown editor (TipTap, SolidJS) and a fast static renderer that share one schema",
  "keywords": [
    "markdown",
    "wysiwyg",
    "editor",
    "typora",
    "tiptap",
    "prosemirror",
    "solid-js",
    "katex",
    "mermaid",
    "codemirror"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhnocoder/codeboard.git",
    "directory": "packages/markdown"
  },
  "homepage": "https://github.com/yhnocoder/codeboard/tree/main/packages/markdown#readme",
  "bugs": "https://github.com/yhnocoder/codeboard/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "default": "./dist/editor/index.js"
    },
    "./code-editor": {
      "types": "./dist/cm/editor.d.ts",
      "default": "./dist/cm/editor.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./style.css": "./dist/style.css",
    "./katex.css": "./dist/katex.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepack": "cp ../../LICENSE LICENSE && npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "gemoji": "8.1.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^29.1.1",
    "solid-js": "^1.9.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@floating-ui/dom": "1.8.0",
    "@tiptap/core": "~3.32.0",
    "@tiptap/extension-bold": "~3.32.0",
    "@tiptap/extension-code": "~3.32.0",
    "@tiptap/extension-code-block": "~3.32.0",
    "@tiptap/extension-details": "~3.32.0",
    "@tiptap/extension-document": "~3.32.0",
    "@tiptap/extension-drag-handle": "~3.32.0",
    "@tiptap/extension-horizontal-rule": "~3.32.0",
    "@tiptap/extension-image": "~3.32.0",
    "@tiptap/extension-italic": "~3.32.0",
    "@tiptap/extension-link": "~3.32.0",
    "@tiptap/extension-list": "~3.32.0",
    "@tiptap/extension-mathematics": "~3.32.0",
    "@tiptap/extension-paragraph": "~3.32.0",
    "@tiptap/extension-strike": "~3.32.0",
    "@tiptap/extension-table": "~3.32.0",
    "@tiptap/extension-underline": "~3.32.0",
    "@tiptap/extensions": "~3.32.0",
    "@tiptap/markdown": "~3.32.0",
    "@tiptap/pm": "~3.32.0",
    "@tiptap/starter-kit": "~3.32.0",
    "@tiptap/suggestion": "~3.32.0",
    "dompurify": "3.4.17",
    "katex": "^0.18.11",
    "marked": "^17.0.6",
    "pele": "^1.6.0",
    "prosemirror-search": "^1.1.1",
    "tiptap-footnotes": "^3.0.1"
  },
  "peerDependencies": {
    "solid-js": "^1.9.17"
  }
}
