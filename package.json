{
  "name": "codeboard",
  "private": true,
  "packageManager": "npm@12.2.1",
  "workspaces": ["packages/*", "extensions/*", "examples/markdown-demo", "apps/*"],
  "scripts": {
    "examples": "sh tools/examples.sh",
    "try": "sh tools/try.sh",
    "build": "node tools/build.mjs codeboard-vscode",
    "package": "npm run build && npm run package -w codeboard-vscode",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check && node tools/test/knip.mjs",
    "format": "biome format --write",
    "e2e": "npm run e2e -w codeboard-vscode",
    "check": "node tools/test/check.mjs",
    "harness": "node tools/test/harness.mjs",
    "storybook": "node tools/build.mjs --deps @codeboard/board && npm run storybook -w @codeboard/board",
    "build-storybook": "node tools/build.mjs --deps @codeboard/board && npm run build-storybook -w @codeboard/board",
    "storybook:check": "npm run build-storybook && node tools/test/storybook.mjs",
    "mac": "sh apps/macos/build.sh",
    "mac:run": "sh apps/macos/build.sh run"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "esbuild": "^0.28.2",
    "knip": "6.44.1",
    "playwright-core": "^1.64.1",
    "vitest": "^5.0.4"
  }
}
