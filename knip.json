{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": ["examples/markdown-demo"],
  "ignoreBinaries": ["mkfifo"],
  // a type named in an exported signature stays exported
  "ignoreExportsUsedInFile": { "interface": true, "type": true },
  "ignoreDependencies": [
    // the wasm is loaded by file path (packages/analysis/src/tree.ts), not imported
    "@yhnocoder/tree-sitter-cuda",
    // a Storybook addon, named only as a string in .storybook/main.ts
    "storybook-addon-pseudo-states"
  ],
  "workspaces": {
    ".": { "entry": ["tools/**/*.{mjs,cjs}", "vitest.config.mts"], "project": ["tools/**/*.{mjs,cjs}"] },
    "packages/core": { "includeEntryExports": true, "entry": ["test/**/*.ts"], "project": ["src/**/*.ts"] },
    "packages/box": { "includeEntryExports": true, "entry": ["test/**/*.ts", "build.mjs"], "project": ["src/**/*.ts"] },
    "packages/host": { "includeEntryExports": true, "entry": ["test/**/*.ts"], "project": ["src/**/*.ts"] },
    "packages/board": {
      "includeEntryExports": true,
      "entry": ["src/export/viewer.ts", "test/**/*.ts", "stories/**/*.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    // the package's public API is its four entries; an export only npm users need (README) carries @public
    "packages/markdown": {
      "includeEntryExports": true,
      "entry": ["src/index.ts", "src/editor/index.tsx", "src/cm/editor.ts", "src/ui/index.ts", "test/**/*.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["dist/**"]
    },
    "packages/analysis": { "includeEntryExports": true, "entry": ["test/**/*.{ts,mjs}"], "project": ["src/**/*.ts"] },
    "extensions/vscode": { "includeEntryExports": true, "entry": ["esbuild.mjs", "test/**/*.{ts,cjs}"], "project": ["src/**/*.ts"] },
    // the macOS app's JavaScript side: the bundle's entry and its tests
    "apps/macos": { "entry": ["js/entry.ts", "js/test/**/*.ts", "build.mjs"], "project": ["js/**/*.ts"] }
  }
}
