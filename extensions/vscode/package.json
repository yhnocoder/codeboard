{
  "name": "codeboard-vscode",
  "displayName": "CodeBoard",
  "description": "读代码用的白板：把函数放上来，点调用逐层展开，卡片钉在 commit 上。",
  "publisher": "yhnocoder",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:codeboard.board"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codeboard.openBoard",
        "title": "打开白板",
        "category": "CodeBoard",
        "icon": "$(window)"
      },
      {
        "command": "codeboard.newBoard",
        "title": "新建白板",
        "category": "CodeBoard",
        "icon": "$(add)"
      },
      {
        "command": "codeboard.renameBoard",
        "title": "重命名白板",
        "category": "CodeBoard",
        "icon": "$(edit)"
      },
      {
        "command": "codeboard.deleteBoard",
        "title": "删除白板",
        "category": "CodeBoard",
        "icon": "$(trash)"
      },
      {
        "command": "codeboard.addSelection",
        "title": "添加到 CodeBoard",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.addSymbol",
        "title": "把光标所在函数放到白板上",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.focusCard",
        "title": "在白板上查看",
        "category": "CodeBoard"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codeboard.addSelection",
          "when": "editorHasSelection",
          "group": "9_cutcopypaste@99"
        },
        {
          "command": "codeboard.addSymbol",
          "when": "!editorHasSelection",
          "group": "9_cutcopypaste@99"
        }
      ],
      "view/title": [
        {
          "command": "codeboard.newBoard",
          "when": "view == codeboard.boards",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "codeboard.renameBoard",
          "when": "view == codeboard.boards && viewItem == board",
          "group": "inline@1"
        },
        {
          "command": "codeboard.deleteBoard",
          "when": "view == codeboard.boards && viewItem == board",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "codeboard.focusCard",
          "when": "false"
        },
        {
          "command": "codeboard.renameBoard",
          "when": "false"
        },
        {
          "command": "codeboard.deleteBoard",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codeboard.addSymbol",
        "key": "alt+b",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeboard",
          "title": "CodeBoard",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codeboard": [
        {
          "id": "codeboard.boards",
          "name": "白板"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codeboard.boards",
        "contents": "还没有白板。\n[新建白板](command:codeboard.newBoard)\n在编辑器里选中代码，右键「添加到 CodeBoard」，或者在函数里按 Alt+B。"
      }
    ],
    "configuration": {
      "title": "CodeBoard",
      "properties": {
        "codeboard.storageDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "白板文件放在哪个目录。留空时放在 VS Code 为这个工作区准备的存储目录里，不会写进你在读的仓库。可以填绝对路径，或相对工作区根目录的路径。"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "e2e": "bash test/run.sh"
  },
  "dependencies": {
    "@codeboard/core": "^0.1.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3"
  }
}
