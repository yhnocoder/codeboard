{
  "name": "codeboard-vscode",
  "displayName": "CodeBoard",
  "description": "A whiteboard for reading code: put functions on it, click calls to expand them layer by layer, cards pinned to commits.",
  "publisher": "yhnocoder",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:codeboard.board"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codeboard.openBoard",
        "title": "Open Board",
        "category": "CodeBoard",
        "icon": "$(window)"
      },
      {
        "command": "codeboard.openBoardToSide",
        "title": "Open to the Side",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.newBoard",
        "title": "New Board",
        "category": "CodeBoard",
        "icon": "$(add)"
      },
      {
        "command": "codeboard.newGroup",
        "title": "New Group",
        "category": "CodeBoard",
        "icon": "$(new-folder)"
      },
      {
        "command": "codeboard.renameBoard",
        "title": "Rename Board",
        "category": "CodeBoard",
        "icon": "$(edit)"
      },
      {
        "command": "codeboard.duplicateBoard",
        "title": "Duplicate Board",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.deleteBoard",
        "title": "Delete Board",
        "category": "CodeBoard",
        "icon": "$(close)"
      },
      {
        "command": "codeboard.moveToGroup",
        "title": "Move to Group…",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.revealInFolder",
        "title": "Reveal in Folder",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.renameGroup",
        "title": "Rename Group",
        "category": "CodeBoard",
        "icon": "$(edit)"
      },
      {
        "command": "codeboard.deleteGroup",
        "title": "Delete Group",
        "category": "CodeBoard",
        "icon": "$(close)"
      },
      {
        "command": "codeboard.addToBoard",
        "title": "Add to Board",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.addToAnotherBoard",
        "title": "Add to Another Board…",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.addToSelectedCard",
        "title": "Add to Selected Card",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.addFunction",
        "title": "Add Function at Cursor",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.addSidenote",
        "title": "Add as Sidenote",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.revealOnBoard",
        "title": "Reveal on Board",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.switchTarget",
        "title": "Switch Target Board",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.addSymbol",
        "title": "Add Symbol to Board",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.revealSymbol",
        "title": "Reveal Symbol on Board",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.openGithubFile",
        "title": "Open GitHub File",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.boardKey",
        "title": "Board Shortcut",
        "category": "CodeBoard"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codeboard.addToBoard",
          "group": "9_codeboard@1"
        },
        {
          "command": "codeboard.addToAnotherBoard",
          "group": "9_codeboard@2"
        },
        {
          "command": "codeboard.addToSelectedCard",
          "when": "editorHasSelection",
          "group": "9_codeboard@3"
        },
        {
          "command": "codeboard.addFunction",
          "group": "9_codeboard@4"
        },
        {
          "command": "codeboard.addSidenote",
          "group": "9_codeboard@5"
        },
        {
          "command": "codeboard.revealOnBoard",
          "group": "9_codeboard@6"
        }
      ],
      "view/title": [
        {
          "command": "codeboard.newBoard",
          "when": "view == codeboard.boards",
          "group": "navigation@1"
        },
        {
          "command": "codeboard.newGroup",
          "when": "view == codeboard.boards",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "codeboard.renameBoard",
          "when": "view == codeboard.boards && viewItem == board",
          "group": "inline@1"
        },
        {
          "command": "codeboard.deleteBoard",
          "when": "view == codeboard.boards && viewItem == board",
          "group": "inline@2"
        },
        {
          "command": "codeboard.openBoard",
          "when": "view == codeboard.boards && viewItem == board",
          "group": "1_open@1"
        },
        {
          "command": "codeboard.openBoardToSide",
          "when": "view == codeboard.boards && viewItem == board",
          "group": "1_open@2"
        },
        {
          "command": "codeboard.renameBoard",
          "when": "view == codeboard.boards && viewItem == board",
          "group": "2_edit@1"
        },
        {
          "command": "codeboard.duplicateBoard",
          "when": "view == codeboard.boards && viewItem == board",
          "group": "2_edit@2"
        },
        {
          "command": "codeboard.moveToGroup",
          "when": "view == codeboard.boards && viewItem == board",
          "group": "2_edit@3"
        },
        {
          "command": "codeboard.revealInFolder",
          "when": "view == codeboard.boards && viewItem == board",
          "group": "3_misc@1"
        },
        {
          "command": "codeboard.deleteBoard",
          "when": "view == codeboard.boards && viewItem == board",
          "group": "4_del@1"
        },
        {
          "command": "codeboard.newBoard",
          "when": "view == codeboard.boards && viewItem == group",
          "group": "1_new@1"
        },
        {
          "command": "codeboard.renameGroup",
          "when": "view == codeboard.boards && viewItem == group",
          "group": "2_edit@1"
        },
        {
          "command": "codeboard.deleteGroup",
          "when": "view == codeboard.boards && viewItem == group",
          "group": "4_del@1"
        }
      ],
      "commandPalette": [
        {
          "command": "codeboard.openBoardToSide",
          "when": "false"
        },
        {
          "command": "codeboard.duplicateBoard",
          "when": "false"
        },
        {
          "command": "codeboard.moveToGroup",
          "when": "false"
        },
        {
          "command": "codeboard.renameGroup",
          "when": "false"
        },
        {
          "command": "codeboard.deleteGroup",
          "when": "false"
        },
        {
          "command": "codeboard.addSymbol",
          "when": "false"
        },
        {
          "command": "codeboard.revealSymbol",
          "when": "false"
        },
        {
          "command": "codeboard.openGithubFile",
          "when": "false"
        },
        {
          "command": "codeboard.revealInFolder",
          "when": "false"
        },
        {
          "command": "codeboard.deleteBoard",
          "when": "false"
        },
        {
          "command": "codeboard.boardKey",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codeboard.addToBoard",
        "key": "alt+b",
        "when": "editorTextFocus"
      },
      {
        "command": "codeboard.addSidenote",
        "key": "alt+s",
        "when": "editorTextFocus"
      },
      {
        "command": "codeboard.boardKey",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "args": "search",
        "when": "activeWebviewPanelId == 'codeboard.board'"
      },
      {
        "command": "codeboard.boardKey",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "args": "duplicate",
        "when": "activeWebviewPanelId == 'codeboard.board'"
      },
      {
        "command": "codeboard.boardKey",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "args": "fitAll",
        "when": "activeWebviewPanelId == 'codeboard.board'"
      },
      {
        "command": "codeboard.boardKey",
        "key": "ctrl+1",
        "mac": "cmd+1",
        "args": "zoom100",
        "when": "activeWebviewPanelId == 'codeboard.board'"
      },
      {
        "command": "codeboard.boardKey",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "args": "zoomIn",
        "when": "activeWebviewPanelId == 'codeboard.board'"
      },
      {
        "command": "codeboard.boardKey",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "args": "zoomOut",
        "when": "activeWebviewPanelId == 'codeboard.board'"
      },
      {
        "command": "codeboard.boardKey",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "args": "lock",
        "when": "activeWebviewPanelId == 'codeboard.board'"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeboard",
          "title": "CodeBoard",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codeboard": [
        {
          "id": "codeboard.boards",
          "name": "Boards"
        },
        {
          "id": "codeboard.github",
          "name": "GitHub Files"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codeboard.boards",
        "contents": "No boards yet.\n[New Board](command:codeboard.newBoard)\nPlace the cursor in a function and press Alt+B, or select some lines and choose CodeBoard > Add to Board."
      },
      {
        "view": "codeboard.github",
        "contents": "Paste a GitHub file link (with #L line numbers) onto a board to download the file here."
      }
    ],
    "configuration": {
      "title": "CodeBoard",
      "properties": {
        "codeboard.storageDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder for board files. Leave empty to use VS Code workspace storage (outside the repo). Absolute, `~/…`, or relative to the first workspace folder, e.g. `~/notes/codeboard`."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "e2e": "bash test/run.sh"
  },
  "dependencies": {
    "@codeboard/core": "^0.1.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3"
  }
}
