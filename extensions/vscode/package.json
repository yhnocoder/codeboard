{
  "name": "codeboard-vscode",
  "displayName": "CodeBoard: Code Reading Whiteboard",
  "description": "A whiteboard for reading code: put functions on it, click calls to expand them layer by layer, cards pinned to commits.",
  "publisher": "yhnocoder",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yhnocoder/codeboard",
    "directory": "extensions/vscode"
  },
  "homepage": "https://github.com/yhnocoder/codeboard#readme",
  "bugs": {
    "url": "https://github.com/yhnocoder/codeboard/issues"
  },
  "icon": "media/icon.png",
  "keywords": ["whiteboard", "code reading", "call graph", "canvas", "notes", "python", "diagram"],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:codeboard.board"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codeboard.openBoard",
        "title": "Open Board",
        "category": "CodeBoard",
        "icon": "$(window)"
      },
      {
        "command": "codeboard.setDeepseekKey",
        "title": "Set DeepSeek API Key",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.clearDeepseekKey",
        "title": "Clear DeepSeek API Key",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.openBoardToSide",
        "title": "Open to the Side",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.newBoard",
        "title": "New Board",
        "category": "CodeBoard",
        "icon": "$(add)"
      },
      {
        "command": "codeboard.newGroup",
        "title": "New Group",
        "category": "CodeBoard",
        "icon": "$(new-folder)"
      },
      {
        "command": "codeboard.renameBoard",
        "title": "Rename Board",
        "category": "CodeBoard",
        "icon": "$(edit)"
      },
      {
        "command": "codeboard.duplicateBoard",
        "title": "Duplicate Board",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.deleteBoard",
        "title": "Delete Board",
        "category": "CodeBoard",
        "icon": "$(close)"
      },
      {
        "command": "codeboard.moveToGroup",
        "title": "Move to Group…",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.copyToProject",
        "title": "Copy to Another Project…",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.moveToProject",
        "title": "Move to Another Project…",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.moveBoardsIntoProject",
        "title": "Move Boards into Project…",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.exportBoards",
        "title": "Export Boards…",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.importBoards",
        "title": "Import Boards…",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.revealInFolder",
        "title": "Reveal in Folder",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.renameGroup",
        "title": "Rename Group",
        "category": "CodeBoard",
        "icon": "$(edit)"
      },
      {
        "command": "codeboard.deleteGroup",
        "title": "Delete Group",
        "category": "CodeBoard",
        "icon": "$(close)"
      },
      {
        "command": "codeboard.addToBoard",
        "title": "Add to Board",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.addSeparateCards",
        "title": "Add Selection as Separate Cards",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.undoAdd",
        "title": "Undo Add to Board",
        "category": "CodeBoard",
        "enablement": "codeboard.canUndoAdd"
      },
      {
        "command": "codeboard.addToAnotherBoard",
        "title": "Add to Another Board…",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.addToSelectedCard",
        "title": "Add to Selected Card",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.addFunction",
        "title": "Add Function at Cursor",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.addSidenote",
        "title": "Add as Sidenote",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.revealOnBoard",
        "title": "Reveal on Board",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.switchTarget",
        "title": "Switch Target Board",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.addSymbol",
        "title": "Add Symbol to Board",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.revealSymbol",
        "title": "Reveal Symbol on Board",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.openGithubFile",
        "title": "Open GitHub File",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.addGithubRepo",
        "title": "Add Repo…",
        "category": "CodeBoard",
        "icon": "$(add)"
      },
      {
        "command": "codeboard.boardKey",
        "title": "Board Shortcut",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.openSettings",
        "title": "Open Settings",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.copyDiagnostics",
        "title": "Copy Diagnostics",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.captureRun",
        "title": "Capture Run…",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.applyRun",
        "title": "Apply Run…",
        "category": "CodeBoard"
      },
      {
        "command": "codeboard.questions.showAll",
        "title": "Show All Questions",
        "category": "CodeBoard",
        "icon": "$(list-flat)"
      },
      {
        "command": "codeboard.questions.showOpen",
        "title": "Show Open Questions Only",
        "category": "CodeBoard",
        "icon": "$(filter-filled)"
      },
      {
        "command": "codeboard.copyQuestions",
        "title": "Copy Questions as List",
        "category": "CodeBoard",
        "icon": "$(copy)"
      },
      {
        "command": "codeboard.openQuestion",
        "title": "Open Question",
        "category": "CodeBoard"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codeboard.addToBoard",
          "group": "9_codeboard@1"
        },
        {
          "command": "codeboard.addSeparateCards",
          "when": "editorHasSelection",
          "group": "9_codeboard@1"
        },
        {
          "command": "codeboard.addToAnotherBoard",
          "group": "9_codeboard@2"
        },
        {
          "command": "codeboard.addToSelectedCard",
          "when": "editorHasSelection",
          "group": "9_codeboard@3"
        },
        {
          "command": "codeboard.addFunction",
          "group": "9_codeboard@4"
        },
        {
          "command": "codeboard.addSidenote",
          "group": "9_codeboard@5"
        },
        {
          "command": "codeboard.revealOnBoard",
          "group": "9_codeboard@6"
        }
      ],
      "view/title": [
        {
          "command": "codeboard.newBoard",
          "when": "view == codeboard.boards",
          "group": "navigation@1"
        },
        {
          "command": "codeboard.newGroup",
          "when": "view == codeboard.boards",
          "group": "navigation@2"
        },
        {
          "command": "codeboard.moveBoardsIntoProject",
          "when": "view == codeboard.boards",
          "group": "2_storage@1"
        },
        {
          "command": "codeboard.importBoards",
          "when": "view == codeboard.boards",
          "group": "2_transfer@1"
        },
        {
          "command": "codeboard.exportBoards",
          "when": "view == codeboard.boards",
          "group": "2_transfer@2"
        },
        {
          "command": "codeboard.addGithubRepo",
          "when": "view == codeboard.github",
          "group": "navigation@1"
        },
        {
          "command": "codeboard.questions.showAll",
          "when": "view == codeboard.questions && !codeboard.questionsAll",
          "group": "navigation@1"
        },
        {
          "command": "codeboard.questions.showOpen",
          "when": "view == codeboard.questions && codeboard.questionsAll",
          "group": "navigation@1"
        },
        {
          "command": "codeboard.copyQuestions",
          "when": "view == codeboard.questions",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "codeboard.renameBoard",
          "when": "view == codeboard.boards && viewItem == board",
          "group": "inline@1"
        },
        {
          "command": "codeboard.deleteBoard",
          "when": "view == codeboard.boards && viewItem == board",
          "group": "inline@2"
        },
        {
          "command": "codeboard.openBoard",
          "when": "view == codeboard.boards && viewItem == board",
          "group": "1_open@1"
        },
        {
          "command": "codeboard.openBoardToSide",
          "when": "view == codeboard.boards && viewItem == board",
          "group": "1_open@2"
        },
        {
          "command": "codeboard.renameBoard",
          "when": "view == codeboard.boards && viewItem == board",
          "group": "2_edit@1"
        },
        {
          "command": "codeboard.duplicateBoard",
          "when": "view == codeboard.boards && viewItem == board",
          "group": "2_edit@2"
        },
        {
          "command": "codeboard.moveToGroup",
          "when": "view == codeboard.boards && viewItem == board",
          "group": "2_edit@3"
        },
        {
          "command": "codeboard.copyToProject",
          "when": "view == codeboard.boards && viewItem == board",
          "group": "2_edit@4"
        },
        {
          "command": "codeboard.moveToProject",
          "when": "view == codeboard.boards && viewItem == board",
          "group": "2_edit@5"
        },
        {
          "command": "codeboard.exportBoards",
          "when": "view == codeboard.boards && viewItem == board",
          "group": "2_edit@6"
        },
        {
          "command": "codeboard.revealInFolder",
          "when": "view == codeboard.boards && viewItem == board",
          "group": "3_misc@1"
        },
        {
          "command": "codeboard.deleteBoard",
          "when": "view == codeboard.boards && viewItem == board",
          "group": "4_del@1"
        },
        {
          "command": "codeboard.newBoard",
          "when": "view == codeboard.boards && viewItem == group",
          "group": "1_new@1"
        },
        {
          "command": "codeboard.renameGroup",
          "when": "view == codeboard.boards && viewItem == group",
          "group": "2_edit@1"
        },
        {
          "command": "codeboard.exportBoards",
          "when": "view == codeboard.boards && viewItem == group",
          "group": "2_edit@2"
        },
        {
          "command": "codeboard.deleteGroup",
          "when": "view == codeboard.boards && viewItem == group",
          "group": "4_del@1"
        }
      ],
      "commandPalette": [
        {
          "command": "codeboard.openQuestion",
          "when": "false"
        },
        {
          "command": "codeboard.openBoardToSide",
          "when": "false"
        },
        {
          "command": "codeboard.duplicateBoard",
          "when": "false"
        },
        {
          "command": "codeboard.moveToGroup",
          "when": "false"
        },
        {
          "command": "codeboard.renameGroup",
          "when": "false"
        },
        {
          "command": "codeboard.deleteGroup",
          "when": "false"
        },
        {
          "command": "codeboard.addSymbol",
          "when": "false"
        },
        {
          "command": "codeboard.revealSymbol",
          "when": "false"
        },
        {
          "command": "codeboard.openGithubFile",
          "when": "false"
        },
        {
          "command": "codeboard.revealInFolder",
          "when": "false"
        },
        {
          "command": "codeboard.deleteBoard",
          "when": "false"
        },
        {
          "command": "codeboard.boardKey",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codeboard.addToBoard",
        "key": "alt+b",
        "when": "editorTextFocus"
      },
      {
        "command": "codeboard.undoAdd",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "editorTextFocus && codeboard.canUndoAdd"
      },
      {
        "command": "codeboard.addSeparateCards",
        "key": "shift+alt+b",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "codeboard.addSidenote",
        "key": "alt+s",
        "when": "editorTextFocus"
      },
      {
        "command": "codeboard.boardKey",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "args": "search",
        "when": "codeboard.boardFocused"
      },
      {
        "command": "codeboard.boardKey",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "args": "duplicate",
        "when": "codeboard.boardFocused"
      },
      {
        "command": "codeboard.boardKey",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "args": "fitAll",
        "when": "codeboard.boardFocused"
      },
      {
        "command": "codeboard.boardKey",
        "key": "ctrl+1",
        "mac": "cmd+1",
        "args": "zoom100",
        "when": "codeboard.boardFocused"
      },
      {
        "command": "codeboard.boardKey",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "args": "zoomIn",
        "when": "codeboard.boardFocused"
      },
      {
        "command": "codeboard.boardKey",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "args": "zoomOut",
        "when": "codeboard.boardFocused"
      },
      {
        "command": "codeboard.boardKey",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "args": "lock",
        "when": "codeboard.boardFocused"
      },
      {
        "command": "codeboard.boardKey",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "args": "turnIntoBoard",
        "when": "codeboard.boardFocused"
      },
      {
        "command": "codeboard.boardKey",
        "key": "ctrl+,",
        "mac": "cmd+,",
        "args": "settings",
        "when": "codeboard.boardFocused"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeboard",
          "title": "CodeBoard",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codeboard": [
        {
          "id": "codeboard.boards",
          "name": "Boards"
        },
        {
          "id": "codeboard.questions",
          "name": "Questions"
        },
        {
          "id": "codeboard.github",
          "name": "GitHub Files"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codeboard.boards",
        "contents": "No boards yet.\n[New Board](command:codeboard.newBoard)\nPlace the cursor in a function and press Alt+B, or select some lines and choose CodeBoard > Add to Board."
      },
      {
        "view": "codeboard.questions",
        "contents": "No open questions. Put a ? sticker on a code line, or right-click a line and choose Ask a Question."
      },
      {
        "view": "codeboard.github",
        "contents": "Browse a GitHub repo, pick a file and lines, and add them to a board.\n[Add Repo…](command:codeboard.addGithubRepo)\nOr paste a GitHub file link onto a board."
      }
    ],
    "configuration": {
      "title": "CodeBoard",
      "properties": {
        "codeboard.ai.provider": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "copilot", "deepseek", "off"],
          "enumDescriptions": [
            "DeepSeek if an API key is set, otherwise a VS Code language model such as Copilot.",
            "A VS Code language model (for example GitHub Copilot).",
            "DeepSeek. Set the key with \"CodeBoard: Set DeepSeek API Key\".",
            "No gray inline completions."
          ],
          "markdownDescription": "Model for the gray inline completions while you write a Note. The DeepSeek API key is kept in VS Code's secret storage: use **CodeBoard: Set DeepSeek API Key**."
        },
        "codeboard.ai.deepseekModel": {
          "type": "string",
          "default": "deepseek-flash",
          "description": "DeepSeek model for inline completions."
        },
        "codeboard.ai.deepseekBaseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "description": "DeepSeek API base URL."
        },
        "codeboard.editorMarks": {
          "type": "string",
          "default": "all",
          "enum": ["all", "lens", "off"],
          "enumDescriptions": [
            "The \"on N boards\" / \"+ Card\" CodeLens above functions and classes, plus the orange bar next to the line numbers and its mark in the overview ruler for lines on the target board.",
            "Only the CodeLens: no bar next to the line numbers and no overview ruler mark.",
            "No CodeBoard marks in file editors."
          ],
          "description": "What CodeBoard shows in file editors for code that is on a board. Applies right away."
        },
        "codeboard.storageDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder for board files. Leave empty to use the `.codeboard` folder in the first workspace folder when there is one (see **Move Boards into Project…**), otherwise VS Code workspace storage (outside the repo). Absolute, `~/…`, or relative to the first workspace folder, e.g. `~/notes/codeboard`."
        },
        "codeboard.theme": {
          "type": "string",
          "default": "warm-ink",
          "enum": [
            "warm-ink",
            "graphite",
            "soft-light",
            "drafting",
            "colorful",
            "newspaper",
            "poster",
            "classic",
            "ink-wash",
            "city"
          ],
          "enumDescriptions": [
            "Warm Ink",
            "Graphite",
            "Soft Light",
            "Drafting",
            "Colorful",
            "Newspaper",
            "Poster",
            "Classic",
            "Ink Wash",
            "City (Experimental)"
          ],
          "description": "Board theme. Each theme has a light and a dark variant that follows VS Code. City is experimental."
        },
        "codeboard.newCards.hide": {
          "type": "object",
          "default": {
            "blank": false
          },
          "properties": {
            "comments": {
              "type": "boolean"
            },
            "docstrings": {
              "type": "boolean"
            },
            "blank": {
              "type": "boolean"
            }
          },
          "description": "What new code cards hide by default."
        },
        "codeboard.studyScope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Packages outside the workspace that count as project code (e.g. torch, vllm)."
        },
        "codeboard.stickerFolder": {
          "type": "string",
          "default": "",
          "description": "Folder with sticker packs (Iconify JSON files, or folders of SVG, PNG, WebP or GIF images; animated ones play)."
        },
        "codeboard.debug.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show a Debug section in CodeBoard Settings for tuning timings and distances."
        },
        "codeboard.debug.tune": {
          "type": "object",
          "default": {},
          "description": "Tuned constants from the Debug section (empty = defaults)."
        },
        "codeboard.doubleClick": {
          "type": "string",
          "enum": ["text", "note", "code", "none"],
          "enumDescriptions": ["Text", "Note", "Free Code card", "Nothing"],
          "default": "text",
          "description": "What double-clicking empty board space creates."
        },
        "codeboard.notes.headingInBody": {
          "type": "boolean",
          "default": false,
          "description": "When a Note starts with a heading, the card's title bar shows it. Also show it at the top of the Note's text (it always shows while editing)."
        },
        "codeboard.math.preamble": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "markdownDescription": "Math preamble: `\\newcommand` and `\\def` lines that every formula on the boards can use, for example `\\newcommand{\\R}{\\mathbb{R}}`. The board's Settings page saves it in the workspace (this project); a user-level value applies to projects without their own. Applies right away to Notes, the editor and exports."
        },
        "codeboard.notes.fontSize": {
          "type": "object",
          "default": {},
          "additionalProperties": false,
          "properties": {
            "body": {
              "type": ["number", "null"],
              "minimum": 10,
              "maximum": 24,
              "description": "Body text size in px. Leave out or null to use the theme's size."
            },
            "h1": {
              "type": ["number", "null"],
              "minimum": 10,
              "maximum": 40,
              "description": "Heading 1 size in px. Leave out or null to use the theme's size."
            },
            "h2": {
              "type": ["number", "null"],
              "minimum": 10,
              "maximum": 40,
              "description": "Heading 2 size in px. Leave out or null to use the theme's size."
            },
            "h3": {
              "type": ["number", "null"],
              "minimum": 10,
              "maximum": 40,
              "description": "Heading 3 size in px. Leave out or null to use the theme's size."
            },
            "h4": {
              "type": ["number", "null"],
              "minimum": 10,
              "maximum": 40,
              "description": "Heading 4 size in px. Leave out or null to use the theme's size."
            },
            "h5": {
              "type": ["number", "null"],
              "minimum": 10,
              "maximum": 40,
              "description": "Heading 5 size in px. Leave out or null to use the theme's size."
            },
            "h6": {
              "type": ["number", "null"],
              "minimum": 10,
              "maximum": 40,
              "description": "Heading 6 size in px. Leave out or null to use the theme's size."
            }
          },
          "description": "Font sizes in Notes, in px: body text and each heading level. Levels left out follow the theme (headings scale with the body text). Text cards keep their own sizes."
        },
        "codeboard.flowNumbers.hide": {
          "type": "boolean",
          "default": false,
          "description": "Hide the call graph marks (A, B… or an icon) on cards."
        },
        "codeboard.useVSCodeBackground": {
          "type": "boolean",
          "default": false,
          "description": "Use VS Code's editor background as the board background in every theme. Cards, text and accent colors stay the theme's; patterns such as grids stay on top."
        },
        "codeboard.themeReflow": {
          "type": "string",
          "enum": ["push", "overlap"],
          "enumDescriptions": ["Push cards below down", "Allow overlap"],
          "default": "push",
          "description": "When switching themes makes cards taller: push the cards below them down, or let them overlap."
        },
        "codeboard.sharedCards.paste": {
          "type": "string",
          "enum": ["linked", "copy"],
          "enumDescriptions": ["Linked card: the same card on both boards, content stays in sync", "Copy: a new card that changes on its own"],
          "default": "linked",
          "description": "What pasting a card onto another board makes. Holding Alt (Option) while pasting makes the other one."
        },
        "codeboard.sharedCards.update": {
          "type": "string",
          "enum": ["ask", "all", "this"],
          "enumDescriptions": ["Ask every time", "Update on all boards", "Update this board only (makes a copy here)"],
          "default": "ask",
          "description": "When updating a card that is on several boards to a new version."
        },
        "codeboard.subBoards.preview": {
          "type": "string",
          "enum": ["skeleton", "title"],
          "enumDescriptions": ["Named skeleton: card titles, call graph marks and arrows of the board inside", "Title only: the board's name and card count"],
          "default": "skeleton",
          "description": "What a sub-board frame shows on its parent board."
        },
        "codeboard.questions.welcomeBack": {
          "type": "string",
          "enum": ["2d", "always", "off"],
          "enumDescriptions": ["When the board was last opened more than 2 days ago", "Every time a board with open questions opens", "Never"],
          "default": "2d",
          "description": "When reopening a board, show how many questions on it are still open."
        },
        "codeboard.export.includeQuestions": {
          "type": "boolean",
          "default": false,
          "description": "Include questions (? stickers) in HTML and Markdown exports by default."
        },
        "codeboard.export.includeBoardOnlyNotes": {
          "type": "boolean",
          "default": false,
          "description": "Include Board-only sidenotes (private notes on linked cards) in exports by default."
        },
        "codeboard.export.scope": {
          "type": "string",
          "enum": ["board", "sections", "walk"],
          "enumDescriptions": ["Whole board", "Selected sections", "One walkthrough path (from the Start card or the selected card)"],
          "default": "board",
          "description": "What the Export dialog exports by default."
        },
        "codeboard.zoom.overview": {
          "type": "number",
          "default": 0.6,
          "minimum": 0.2,
          "maximum": 1,
          "description": "Below this zoom, cards show an overview (titles and structure)."
        },
        "codeboard.zoom.map": {
          "type": "number",
          "default": 0.25,
          "minimum": 0.05,
          "maximum": 0.6,
          "description": "Below this zoom, cards show only their titles (map view)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "e2e": "bash test/run.sh",
    "test": "vitest run",
    "package": "cp ../../LICENSE LICENSE && npx -y @vscode/vsce@3.9.2 package --no-dependencies -o codeboard-vscode-$npm_package_version.vsix"
  },
  "dependencies": {
    "@codeboard/core": "^0.1.0",
    "@codeboard/host": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
