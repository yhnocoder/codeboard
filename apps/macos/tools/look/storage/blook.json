     "text": [
      "    def encode(self, text: str) -> list[int]:",
      "        # split on spaces, then look each word up",
      "        words = text.split()",
      "        ids = []",
      "        for w in words:",
      "            ids.append(self.vocab.get(w, 0))",
      "        if not ids:",
      "            raise ValueError(\"empty\")",
      "        seen = set()",
      "        for i in ids:",
      "            seen.add(i)",
      "        self.last = ids",
      "        return ids"
     ],
